# ============================================
# 昇腾云 API 配置 (GitCode AI 平台)
# ============================================
# 获取方式: https://gitcode.com 登录后 -> AI 平台 -> 模型服务 -> API Key
# 可用模型: zai-org/GLM-5.2 (已验证), deepseek-ai/DeepSeek-V4 (可用)
# 说明: 未配置时系统自动降级为规则模板, 报告不走 LLM 润色
ASCEND_API_BASE=https://api-ai.gitcode.com/v1
ASCEND_API_KEY=your_api_key_here
ASCEND_MODEL=zai-org/GLM-5.2

# ============================================
# 可选: 财务演示数据兜底 (仅黑客松演示)
# ============================================
# 真实财务缺失时用【演示数据】填充价值/成长因子, UI 会标注"演示数据"
# 0=关闭 (默认, 无数据即0分) | 1=开启 (demo_prep 自动开启)
DEMO_DATA_FALLBACK=0
